				value='0?10[1-2]|0?199|0?20[1-9]|0?21[0-3]|0?299' />
		</xs:restriction>
	</xs:simpleType>

	<!-- IMPORTANTE: O campo Origem de Recursos é mapeado com apenas dois dígitos 
		da operação para o agregado. Por exemplo, uma operação com origem de recursos 
		0212 é transferida para o agregado de origem de recursos 0200. Portanto, 
		deve-se incluir apenas valores com final xx00 no tipo abaixo (ie. '0100', 
		'0200'). Isso deve ser feito apenas quando uma nova categoria for incluída 
		no tipoOrigemRec. Por exemplo, quando a origem de recurso 0301 for incluída 
		no tipo acima, deve-se incluir o valor 0300 abaixo. -->
	<xs:simpleType name='tipoOrigemRecAgreg'>
		<xs:restriction base='xs:string'>
			<xs:whiteSpace value='collapse' />
			<xs:pattern value='0?100|0?200' />
		</xs:restriction>
	</xs:simpleType>

