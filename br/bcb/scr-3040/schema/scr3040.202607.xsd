	<!-- Definicao de tipos para atributos especificos -->
	<xs:simpleType name='tipoNaturezaIndiv'>
		<xs:restriction base='xs:string'>
			<xs:whiteSpace value='collapse' />
			<xs:pattern value='0?[1-5]|1[1-6]|32|33|34' />
